{
  "entities": {
    "RunnerProfile": {
      "title": "RunnerProfile",
      "description": "Biometric and training target preferences for a PaceCraft runner.",
      "type": "object",
      "properties": {
        "weightKg": { "type": "number", "description": "Body weight in kilograms (30-200)." },
        "heightCm": { "type": "number", "description": "Height in centimeters (120-230)." },
        "directBmi": { "type": "number", "description": "Optional direct BMI override (10-60) or null." },
        "useDirectBmi": { "type": "boolean", "description": "Whether direct BMI input is active." },
        "age": { "type": "number", "description": "Runner age in years (12-100)." },
        "injuryStatus": {
          "type": "string",
          "enum": ["none", "recovering", "active"],
          "maxLength": 16
        },
        "targetRace": {
          "type": "string",
          "enum": ["5K", "10K", "21K", "42K"],
          "maxLength": 8
        },
        "trainingDaysPerWeek": {
          "type": "number",
          "enum": [3, 4, 5, 6]
        },
        "restingHrBpm": { "type": "number", "description": "Resting heart rate in bpm (35-110)." },
        "maxHrBpm": { "type": "number", "description": "Optional custom max heart rate in bpm (120-230) or null." },
        "customTargetPaceSecPerKm": { "type": "number", "description": "Optional target race pace in sec/km (120-1800) applied from Pace Calculator or null." },
        "shoeName": { "type": "string", "maxLength": 60, "description": "Primary running shoe model name." },
        "shoeCurrentKm": { "type": "number", "description": "Accumulated mileage on primary running shoe (0-10000 km)." },
        "shoeMaxKm": { "type": "number", "description": "Recommended lifespan limit for running shoe (200-2000 km)." },
        "pb5kSec": { "type": "number", "description": "Optional Personal Best 5K finish time in seconds (600-36000) or null." },
        "pb10kSec": { "type": "number", "description": "Optional Personal Best 10K finish time in seconds (600-36000) or null." },
        "pb21kSec": { "type": "number", "description": "Optional Personal Best 21.1K finish time in seconds (600-36000) or null." },
        "pb42kSec": { "type": "number", "description": "Optional Personal Best 42.2K finish time in seconds (600-36000) or null." },
        "onboardingCompleted": { "type": "boolean", "description": "Whether the runner completed or skipped the initial 30-second setup wizard." }
      },
      "required": [
        "weightKg",
        "heightCm",
        "useDirectBmi",
        "age",
        "injuryStatus",
        "targetRace",
        "trainingDaysPerWeek"
      ]
    },
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Per-account runner preferences, language, and target race countdown metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "language": {
          "type": "string",
          "enum": ["id", "en"],
          "maxLength": 4
        },
        "customRaceDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
        },
        "customRaceName": {
          "type": "string",
          "maxLength": 80
        },
        "migratedFromLocal": {
          "type": "boolean"
        },
        "profile": {
          "type": "object",
          "$ref": "#/entities/RunnerProfile"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "language",
        "profile",
        "createdAt",
        "updatedAt"
      ]
    },
    "DailyProgress": {
      "title": "DailyProgress",
      "description": "Logged daily training session entry including pace, heart rate, comfort, and notes.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "dayIndex": { "type": "number" },
        "sessionTitle": { "type": "string", "maxLength": 120 },
        "zone": {
          "type": "string",
          "enum": ["easy", "tempo", "interval", "long_run", "rest"],
          "maxLength": 16
        },
        "plannedKm": { "type": "number" },
        "actualKm": { "type": "number" },
        "paceSecPerKm": { "type": "number" },
        "avgHeartRateBpm": { "type": "number" },
        "comfortRating": { "type": "number", "enum": [1, 2, 3, 4, 5] },
        "note": { "type": "string", "maxLength": 280 },
        "completedAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "dateKey",
        "dayIndex",
        "sessionTitle",
        "zone",
        "plannedKm",
        "actualKm",
        "comfortRating",
        "note",
        "completedAt",
        "updatedAt"
      ]
    },
    "RunActivity": {
      "title": "RunActivity",
      "description": "Imported or sample Strava running session scoped to an authenticated runner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": { "type": "string", "maxLength": 160 },
        "type": {
          "type": "string",
          "enum": ["Run", "TrailRun", "VirtualRun"],
          "maxLength": 20
        },
        "startDate": { "type": "string", "maxLength": 40 },
        "distanceMeters": { "type": "number" },
        "movingTimeSeconds": { "type": "number" },
        "elapsedTimeSeconds": { "type": "number" },
        "elevationGainMeters": { "type": "number" },
        "averageHeartRate": { "type": "number" },
        "maxSpeedMps": { "type": "number" },
        "averageSpeedMps": { "type": "number" },
        "summaryPolyline": { "type": "string", "maxLength": 50000 },
        "source": {
          "type": "string",
          "enum": ["sample", "csv", "gpx", "strava_oauth"],
          "maxLength": 20
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "id",
        "name",
        "type",
        "startDate",
        "distanceMeters",
        "movingTimeSeconds",
        "elapsedTimeSeconds",
        "elevationGainMeters",
        "maxSpeedMps",
        "averageSpeedMps",
        "source",
        "updatedAt"
      ]
    },
    "AccessGrant": {
      "title": "AccessGrant",
      "description": "Paid buyer access entitlement or manual payment confirmation request keyed by Firebase Auth UID (no email PII stored).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "active", "revoked"],
          "maxLength": 16
        },
        "planType": {
          "type": "string",
          "enum": ["lifetime", "pro"],
          "maxLength": 16
        },
        "provider": {
          "type": "string",
          "enum": ["stripe", "midtrans", "license", "admin_manual", "owner"],
          "maxLength": 24
        },
        "orderRef": {
          "type": "string",
          "maxLength": 80
        },
        "note": {
          "type": "string",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "status",
        "planType",
        "provider",
        "orderRef",
        "note",
        "createdAt",
        "updatedAt"
      ]
    },
    "AccessCode": {
      "title": "AccessCode",
      "description": "Single-use buyer license key stored in access-codes; marked 'used' and locked to one Google UID upon first redemption.",
      "type": "object",
      "properties": {
        "codeId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Z0-9][A-Z0-9_\\-]{7,63}$"
        },
        "planType": {
          "type": "string",
          "enum": ["lifetime", "pro"],
          "maxLength": 16
        },
        "status": {
          "type": "string",
          "enum": ["unused", "used", "revoked"],
          "maxLength": 16
        },
        "buyerNote": {
          "type": "string",
          "maxLength": 120
        },
        "usedByUid": {
          "type": "string",
          "maxLength": 128
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "codeId",
        "planType",
        "status",
        "usedByUid",
        "usedAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspace" },
      "description": "Owner-only runner workspace profile, language preference, and race countdown configuration."
    },
    "/users/{userId}/progress/{progressId}": {
      "schema": { "$ref": "#/entities/DailyProgress" },
      "description": "Owner-only daily training logs keyed by YYYY-MM-DD_dayIndex."
    },
    "/users/{userId}/runs/{runId}": {
      "schema": { "$ref": "#/entities/RunActivity" },
      "description": "Owner-only imported or sample Strava run activities."
    },
    "/accessGrants/{userId}": {
      "schema": { "$ref": "#/entities/AccessGrant" },
      "description": "Paid buyer entitlement records and pending transfer confirmation requests; only verified Admin or atomic single-use access-codes redemption may activate."
    },
    "/access-codes/{codeId}": {
      "schema": { "$ref": "#/entities/AccessCode" },
      "description": "Single-use license keys created by Admin and marked 'used' atomically by the first verified buyer on login."
    }
  }
}
