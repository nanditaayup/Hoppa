# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Strava OAuth API credentials (only required if using Strava OAuth sync)
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""

# Firebase App Check (reCAPTCHA Enterprise / Google Cloud Fraud Defense or reCAPTCHA v3 Site Key)
NEXT_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_KEY=""
# Provider type: "enterprise" (Google Cloud Fraud Defense / reCAPTCHA Enterprise) or "v3"
NEXT_PUBLIC_FIREBASE_APPCHECK_PROVIDER="enterprise"
# Set to "true" only in local development to register a Firebase App Check debug token
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=""

# Commercial Access & Payment Gateway Configuration (Server-only secrets)
# HMAC secret for signed buyer entitlement cookies & generated license keys
ACCESS_SIGNING_SECRET=""
# Optional single or comma-separated buyer access passcodes
BUYER_ACCESS_CODE=""
BUYER_ACCESS_CODES=""
# Optional external checkout URL (e.g., Mayar, Lynk.id, Midtrans Snap link, Stripe Payment Link)
PAYMENT_CHECKOUT_URL=""
# Optional Stripe Checkout API credentials
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""

# Optional Indonesian Seller QRIS, Bank & WhatsApp Confirmation Config (public display)
NEXT_PUBLIC_SELLER_WHATSAPP=""
NEXT_PUBLIC_QRIS_IMAGE_URL=""
NEXT_PUBLIC_BANK_ACCOUNT_INFO=""
NEXT_PUBLIC_MERCHANT_NAME="PaceCraft Indonesia"
NEXT_PUBLIC_SUPPORT_EMAIL="nanditayup@gmail.com"
