rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidRunnerProfile(p) {
      return p is map
        && p.keys().hasAll([
          'weightKg',
          'heightCm',
          'directBmi',
          'useDirectBmi',
          'age',
          'injuryStatus',
          'targetRace',
          'trainingDaysPerWeek',
          'restingHrBpm',
          'maxHrBpm'
        ])
        && p.keys().hasOnly([
          'weightKg',
          'heightCm',
          'directBmi',
          'useDirectBmi',
          'age',
          'injuryStatus',
          'targetRace',
          'trainingDaysPerWeek',
          'restingHrBpm',
          'maxHrBpm'
        ])
        && p.weightKg is number && p.weightKg >= 30 && p.weightKg <= 200
        && p.heightCm is number && p.heightCm >= 120 && p.heightCm <= 230
        && (p.directBmi == null || (p.directBmi is number && p.directBmi >= 10 && p.directBmi <= 60))
        && p.useDirectBmi is bool
        && p.age is number && p.age >= 12 && p.age <= 100
        && p.injuryStatus is string && p.injuryStatus.size() <= 16 && p.injuryStatus in ['none', 'recovering', 'active']
        && p.targetRace is string && p.targetRace.size() <= 8 && p.targetRace in ['5K', '10K', '21K', '42K']
        && p.trainingDaysPerWeek is number && p.trainingDaysPerWeek in [3, 4, 5, 6]
        && p.restingHrBpm is number && p.restingHrBpm >= 35 && p.restingHrBpm <= 110
        && (p.maxHrBpm == null || (p.maxHrBpm is number && p.maxHrBpm >= 120 && p.maxHrBpm <= 230));
    }

    function isValidUserWorkspace(data, userId) {
      return data.keys().hasAll([
          'uid',
          'language',
          'customRaceDate',
          'customRaceName',
          'migratedFromLocal',
          'profile',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'language',
          'customRaceDate',
          'customRaceName',
          'migratedFromLocal',
          'profile',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.language is string && data.language.size() <= 4 && data.language in ['id', 'en']
        && data.customRaceDate is string && data.customRaceDate.size() <= 10 && data.customRaceDate.matches('^(\\d{4}-\\d{2}-\\d{2})?$')
        && data.customRaceName is string && data.customRaceName.size() <= 80
        && data.migratedFromLocal is bool
        && isValidRunnerProfile(data.profile)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyProgress(data, userId) {
      return data.keys().hasAll([
          'uid',
          'dateKey',
          'dayIndex',
          'sessionTitle',
          'zone',
          'plannedKm',
          'actualKm',
          'paceSecPerKm',
          'avgHeartRateBpm',
          'comfortRating',
          'note',
          'completedAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'dateKey',
          'dayIndex',
          'sessionTitle',
          'zone',
          'plannedKm',
          'actualKm',
          'paceSecPerKm',
          'avgHeartRateBpm',
          'comfortRating',
          'note',
          'completedAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.dayIndex is number && data.dayIndex >= 0 && data.dayIndex <= 6
        && data.sessionTitle is string && data.sessionTitle.size() >= 1 && data.sessionTitle.size() <= 120
        && data.zone is string && data.zone.size() <= 16 && data.zone in ['easy', 'tempo', 'interval', 'long_run', 'rest']
        && data.plannedKm is number && data.plannedKm >= 0 && data.plannedKm <= 300
        && data.actualKm is number && data.actualKm >= 0 && data.actualKm <= 300
        && (data.paceSecPerKm == null || (data.paceSecPerKm is number && data.paceSecPerKm >= 120 && data.paceSecPerKm <= 1800))
        && (data.avgHeartRateBpm == null || (data.avgHeartRateBpm is number && data.avgHeartRateBpm >= 35 && data.avgHeartRateBpm <= 240))
        && data.comfortRating is number && data.comfortRating in [1, 2, 3, 4, 5]
        && data.note is string && data.note.size() <= 280
        && data.completedAt is string && data.completedAt.size() >= 10 && data.completedAt.size() <= 40
        && data.updatedAt is timestamp;
    }

    function isValidRunActivity(data, userId) {
      return data.keys().hasAll([
          'uid',
          'id',
          'name',
          'type',
          'startDate',
          'distanceMeters',
          'movingTimeSeconds',
          'elapsedTimeSeconds',
          'elevationGainMeters',
          'averageHeartRate',
          'maxSpeedMps',
          'averageSpeedMps',
          'summaryPolyline',
          'source',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'id',
          'name',
          'type',
          'startDate',
          'distanceMeters',
          'movingTimeSeconds',
          'elapsedTimeSeconds',
          'elevationGainMeters',
          'averageHeartRate',
          'maxSpeedMps',
          'averageSpeedMps',
          'summaryPolyline',
          'source',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.type is string && data.type.size() <= 20 && data.type in ['Run', 'TrailRun', 'VirtualRun']
        && data.startDate is string && data.startDate.size() >= 10 && data.startDate.size() <= 40
        && data.distanceMeters is number && data.distanceMeters >= 0 && data.distanceMeters <= 500000
        && data.movingTimeSeconds is number && data.movingTimeSeconds >= 0 && data.movingTimeSeconds <= 604800
        && data.elapsedTimeSeconds is number && data.elapsedTimeSeconds >= 0 && data.elapsedTimeSeconds <= 604800
        && data.elevationGainMeters is number && data.elevationGainMeters >= 0 && data.elevationGainMeters <= 30000
        && (data.averageHeartRate == null || (data.averageHeartRate is number && data.averageHeartRate >= 35 && data.averageHeartRate <= 240))
        && data.maxSpeedMps is number && data.maxSpeedMps >= 0 && data.maxSpeedMps <= 30
        && data.averageSpeedMps is number && data.averageSpeedMps >= 0 && data.averageSpeedMps <= 30
        && (data.summaryPolyline == null || (data.summaryPolyline is string && data.summaryPolyline.size() <= 50000))
        && data.source is string && data.source.size() <= 20 && data.source in ['sample', 'csv', 'gpx', 'strava_oauth']
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserWorkspace(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserWorkspace(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['profile', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['language', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['customRaceDate', 'customRaceName', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['customRaceDate', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['customRaceName', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['migratedFromLocal', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'language',
            'customRaceDate',
            'customRaceName',
            'migratedFromLocal',
            'profile',
            'updatedAt'
          ])
        );
      allow delete: if isValidId(userId) && isOwner(userId);

      match /progress/{progressId} {
        allow get: if isValidId(userId) && isValidId(progressId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(progressId)
          && isOwner(userId)
          && isValidDailyProgress(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(progressId)
          && isOwner(userId)
          && isValidDailyProgress(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().dateKey == existing().dateKey
          && incoming().dayIndex == existing().dayIndex
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'sessionTitle',
            'zone',
            'plannedKm',
            'actualKm',
            'paceSecPerKm',
            'avgHeartRateBpm',
            'comfortRating',
            'note',
            'completedAt',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(progressId) && isOwner(userId);
      }

      match /runs/{runId} {
        allow get: if isValidId(userId) && isValidId(runId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(runId)
          && isOwner(userId)
          && isValidRunActivity(incoming(), userId)
          && incoming().id == runId
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(runId)
          && isOwner(userId)
          && isValidRunActivity(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().id == existing().id
          && incoming().id == runId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'type',
            'startDate',
            'distanceMeters',
            'movingTimeSeconds',
            'elapsedTimeSeconds',
            'elevationGainMeters',
            'averageHeartRate',
            'maxSpeedMps',
            'averageSpeedMps',
            'summaryPolyline',
            'source',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(runId) && isOwner(userId);
      }
    }
  }
}
