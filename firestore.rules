rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'nanditayup@gmail.com';
    }

    function isValidRunnerProfile(p) {
      return p is map
        && p.keys().hasAll([
          'weightKg',
          'heightCm',
          'useDirectBmi',
          'age',
          'injuryStatus',
          'targetRace',
          'trainingDaysPerWeek'
        ])
        && p.keys().hasOnly([
          'weightKg',
          'heightCm',
          'directBmi',
          'useDirectBmi',
          'age',
          'injuryStatus',
          'targetRace',
          'trainingDaysPerWeek',
          'restingHrBpm',
          'maxHrBpm',
          'customTargetPaceSecPerKm',
          'shoeName',
          'shoeCurrentKm',
          'shoeMaxKm',
          'pb5kSec',
          'pb10kSec',
          'pb21kSec',
          'pb42kSec',
          'onboardingCompleted'
        ])
        && p.weightKg is number && p.weightKg >= 30 && p.weightKg <= 200
        && p.heightCm is number && p.heightCm >= 120 && p.heightCm <= 230
        && (!('directBmi' in p) || p.directBmi == null || (p.directBmi is number && p.directBmi >= 10 && p.directBmi <= 60))
        && p.useDirectBmi is bool
        && p.age is number && p.age >= 12 && p.age <= 100
        && p.injuryStatus is string && p.injuryStatus.size() <= 16 && p.injuryStatus in ['none', 'recovering', 'active']
        && p.targetRace is string && p.targetRace.size() <= 8 && p.targetRace in ['5K', '10K', '21K', '42K']
        && p.trainingDaysPerWeek is number && p.trainingDaysPerWeek in [3, 4, 5, 6]
        && (!('restingHrBpm' in p) || (p.restingHrBpm is number && p.restingHrBpm >= 35 && p.restingHrBpm <= 110))
        && (!('maxHrBpm' in p) || p.maxHrBpm == null || (p.maxHrBpm is number && p.maxHrBpm >= 120 && p.maxHrBpm <= 230))
        && (!('customTargetPaceSecPerKm' in p) || p.customTargetPaceSecPerKm == null || (p.customTargetPaceSecPerKm is number && p.customTargetPaceSecPerKm >= 120 && p.customTargetPaceSecPerKm <= 1800))
        && (!('shoeName' in p) || (p.shoeName is string && p.shoeName.size() <= 60))
        && (!('shoeCurrentKm' in p) || (p.shoeCurrentKm is number && p.shoeCurrentKm >= 0 && p.shoeCurrentKm <= 10000))
        && (!('shoeMaxKm' in p) || (p.shoeMaxKm is number && p.shoeMaxKm >= 200 && p.shoeMaxKm <= 2000))
        && (!('pb5kSec' in p) || p.pb5kSec == null || (p.pb5kSec is number && p.pb5kSec >= 600 && p.pb5kSec <= 36000))
        && (!('pb10kSec' in p) || p.pb10kSec == null || (p.pb10kSec is number && p.pb10kSec >= 600 && p.pb10kSec <= 36000))
        && (!('pb21kSec' in p) || p.pb21kSec == null || (p.pb21kSec is number && p.pb21kSec >= 600 && p.pb21kSec <= 36000))
        && (!('pb42kSec' in p) || p.pb42kSec == null || (p.pb42kSec is number && p.pb42kSec >= 600 && p.pb42kSec <= 36000))
        && (!('onboardingCompleted' in p) || p.onboardingCompleted is bool);
    }

    function isValidUserWorkspace(data, userId) {
      return data.keys().hasAll([
          'uid',
          'language',
          'profile',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'language',
          'customRaceDate',
          'customRaceName',
          'migratedFromLocal',
          'profile',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.language is string && data.language.size() <= 4 && data.language in ['id', 'en']
        && (!('customRaceDate' in data) || data.customRaceDate == null || (data.customRaceDate is string && data.customRaceDate.size() <= 10 && data.customRaceDate.matches('^(\\d{4}-\\d{2}-\\d{2})?$')))
        && (!('customRaceName' in data) || data.customRaceName == null || (data.customRaceName is string && data.customRaceName.size() <= 80))
        && (!('migratedFromLocal' in data) || data.migratedFromLocal is bool)
        && isValidRunnerProfile(data.profile)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyProgress(data, userId) {
      return data.keys().hasAll([
          'uid',
          'dateKey',
          'dayIndex',
          'sessionTitle',
          'zone',
          'plannedKm',
          'actualKm',
          'paceSecPerKm',
          'avgHeartRateBpm',
          'comfortRating',
          'note',
          'completedAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'dateKey',
          'dayIndex',
          'sessionTitle',
          'zone',
          'plannedKm',
          'actualKm',
          'paceSecPerKm',
          'avgHeartRateBpm',
          'comfortRating',
          'note',
          'completedAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.dayIndex is number && data.dayIndex >= 0 && data.dayIndex <= 6
        && data.sessionTitle is string && data.sessionTitle.size() >= 1 && data.sessionTitle.size() <= 120
        && data.zone is string && data.zone.size() <= 16 && data.zone in ['easy', 'tempo', 'interval', 'long_run', 'rest']
        && data.plannedKm is number && data.plannedKm >= 0 && data.plannedKm <= 300
        && data.actualKm is number && data.actualKm >= 0 && data.actualKm <= 300
        && (data.paceSecPerKm == null || (data.paceSecPerKm is number && data.paceSecPerKm >= 120 && data.paceSecPerKm <= 1800))
        && (data.avgHeartRateBpm == null || (data.avgHeartRateBpm is number && data.avgHeartRateBpm >= 35 && data.avgHeartRateBpm <= 240))
        && data.comfortRating is number && data.comfortRating in [1, 2, 3, 4, 5]
        && data.note is string && data.note.size() <= 280
        && data.completedAt is string && data.completedAt.size() >= 10 && data.completedAt.size() <= 40
        && data.updatedAt is timestamp;
    }

    function isValidRunActivity(data, userId) {
      return data.keys().hasAll([
          'uid',
          'id',
          'name',
          'type',
          'startDate',
          'distanceMeters',
          'movingTimeSeconds',
          'elapsedTimeSeconds',
          'elevationGainMeters',
          'averageHeartRate',
          'maxSpeedMps',
          'averageSpeedMps',
          'summaryPolyline',
          'source',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'id',
          'name',
          'type',
          'startDate',
          'distanceMeters',
          'movingTimeSeconds',
          'elapsedTimeSeconds',
          'elevationGainMeters',
          'averageHeartRate',
          'maxSpeedMps',
          'averageSpeedMps',
          'summaryPolyline',
          'source',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.type is string && data.type.size() <= 20 && data.type in ['Run', 'TrailRun', 'VirtualRun']
        && data.startDate is string && data.startDate.size() >= 10 && data.startDate.size() <= 40
        && data.distanceMeters is number && data.distanceMeters >= 0 && data.distanceMeters <= 500000
        && data.movingTimeSeconds is number && data.movingTimeSeconds >= 0 && data.movingTimeSeconds <= 604800
        && data.elapsedTimeSeconds is number && data.elapsedTimeSeconds >= 0 && data.elapsedTimeSeconds <= 604800
        && data.elevationGainMeters is number && data.elevationGainMeters >= 0 && data.elevationGainMeters <= 30000
        && (data.averageHeartRate == null || (data.averageHeartRate is number && data.averageHeartRate >= 35 && data.averageHeartRate <= 240))
        && data.maxSpeedMps is number && data.maxSpeedMps >= 0 && data.maxSpeedMps <= 30
        && data.averageSpeedMps is number && data.averageSpeedMps >= 0 && data.averageSpeedMps <= 30
        && (data.summaryPolyline == null || (data.summaryPolyline is string && data.summaryPolyline.size() <= 50000))
        && data.source is string && data.source.size() <= 20 && data.source in ['sample', 'csv', 'gpx', 'strava_oauth']
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserWorkspace(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserWorkspace(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'language',
          'customRaceDate',
          'customRaceName',
          'migratedFromLocal',
          'profile',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);

      match /progress/{progressId} {
        allow get: if isValidId(userId) && isValidId(progressId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(progressId)
          && isOwner(userId)
          && isValidDailyProgress(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(progressId)
          && isOwner(userId)
          && isValidDailyProgress(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().dateKey == existing().dateKey
          && incoming().dayIndex == existing().dayIndex
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'sessionTitle',
            'zone',
            'plannedKm',
            'actualKm',
            'paceSecPerKm',
            'avgHeartRateBpm',
            'comfortRating',
            'note',
            'completedAt',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(progressId) && isOwner(userId);
      }

      match /runs/{runId} {
        allow get: if isValidId(userId) && isValidId(runId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(runId)
          && isOwner(userId)
          && isValidRunActivity(incoming(), userId)
          && incoming().id == runId
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(runId)
          && isOwner(userId)
          && isValidRunActivity(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().id == existing().id
          && incoming().id == runId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'type',
            'startDate',
            'distanceMeters',
            'movingTimeSeconds',
            'elapsedTimeSeconds',
            'elevationGainMeters',
            'averageHeartRate',
            'maxSpeedMps',
            'averageSpeedMps',
            'summaryPolyline',
            'source',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(runId) && isOwner(userId);
      }
    }

    function isValidAccessGrant(data, userId) {
      return data.keys().hasAll([
          'uid',
          'status',
          'planType',
          'provider',
          'orderRef',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'status',
          'planType',
          'provider',
          'orderRef',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.status is string && data.status.size() <= 16 && data.status in ['pending', 'active', 'revoked']
        && data.planType is string && data.planType.size() <= 16 && data.planType in ['lifetime', 'pro']
        && data.provider is string && data.provider.size() <= 24 && data.provider in ['stripe', 'midtrans', 'license', 'admin_manual', 'owner']
        && data.orderRef is string && data.orderRef.size() <= 80
        && data.note is string && data.note.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccessCode(data, codeId) {
      return data.keys().hasAll([
          'codeId',
          'planType',
          'status',
          'usedByUid',
          'usedAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'codeId',
          'planType',
          'status',
          'buyerNote',
          'usedByUid',
          'usedAt',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.codeId)
        && data.codeId == codeId
        && data.codeId.size() >= 8 && data.codeId.size() <= 64
        && data.planType is string && data.planType.size() <= 16 && data.planType in ['lifetime', 'pro']
        && data.status is string && data.status.size() <= 16 && data.status in ['unused', 'used', 'revoked']
        && (!('buyerNote' in data) || (data.buyerNote is string && data.buyerNote.size() <= 120))
        && (data.usedByUid == null || (isValidId(data.usedByUid) && data.usedByUid.size() <= 128))
        && (data.usedAt == null || data.usedAt is timestamp)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && data.updatedAt is timestamp;
    }

    function isAtomicLicenseRedemption(userId) {
      return isOwner(userId)
        && incoming().uid == request.auth.uid
        && incoming().status == 'active'
        && incoming().provider == 'license'
        && isValidId(incoming().orderRef)
        && exists(/databases/$(database)/documents/access-codes/$(incoming().orderRef))
        && get(/databases/$(database)/documents/access-codes/$(incoming().orderRef)).data.status == 'unused'
        && get(/databases/$(database)/documents/access-codes/$(incoming().orderRef)).data.planType == incoming().planType
        && getAfter(/databases/$(database)/documents/access-codes/$(incoming().orderRef)).data.status == 'used'
        && getAfter(/databases/$(database)/documents/access-codes/$(incoming().orderRef)).data.usedByUid == request.auth.uid;
    }

    match /access-codes/{codeId} {
      allow get: if isValidId(codeId) && isAdmin();
      allow list: if isAdmin() && existing().status in ['unused', 'used', 'revoked'];
      allow create: if isValidId(codeId)
        && isAdmin()
        && isValidAccessCode(incoming(), codeId)
        && incoming().status == 'unused'
        && incoming().usedByUid == null
        && incoming().usedAt == null
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(codeId)
        && isValidAccessCode(incoming(), codeId)
        && incoming().codeId == existing().codeId
        && incoming().planType == existing().planType
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && incoming().usedByUid == existing().usedByUid
            && incoming().usedAt == existing().usedAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'buyerNote', 'updatedAt'])
          )
          || (
            isVerifiedUser()
            && existing().status == 'unused'
            && incoming().status == 'used'
            && incoming().usedByUid == request.auth.uid
            && incoming().usedAt == request.time
            && (!('buyerNote' in existing()) || incoming().buyerNote == existing().buyerNote)
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'usedByUid', 'usedAt', 'updatedAt'])
            && getAfter(/databases/$(database)/documents/accessGrants/$(request.auth.uid)).data.status == 'active'
            && getAfter(/databases/$(database)/documents/accessGrants/$(request.auth.uid)).data.provider == 'license'
            && getAfter(/databases/$(database)/documents/accessGrants/$(request.auth.uid)).data.orderRef == codeId
          )
        );
      allow delete: if isValidId(codeId) && isAdmin();
    }

    match /accessGrants/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() && existing().status in ['pending', 'active', 'revoked'];
      allow create: if isValidId(userId)
        && isValidAccessGrant(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || isAtomicLicenseRedemption(userId)
          || (
            isOwner(userId)
            && incoming().uid == request.auth.uid
            && incoming().status == 'pending'
            && incoming().provider == 'admin_manual'
          )
        );
      allow update: if isValidId(userId)
        && isValidAccessGrant(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && existing().status != 'active'
            && incoming().status == 'pending'
            && incoming().provider == 'admin_manual'
            && incoming().diff(existing()).affectedKeys().hasOnly(['orderRef', 'note', 'status', 'provider', 'updatedAt'])
          )
          || (
            existing().status != 'active'
            && isAtomicLicenseRedemption(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['planType', 'provider', 'orderRef', 'note', 'status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && (isAdmin() || isOwner(userId));
    }
  }
}
